generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique(map: "email") @db.VarChar(255)
  name          String   @db.VarChar(100)
  gender        String   @db.VarChar(15)
  birth         DateTime @db.Date
  address       String   @db.VarChar(255)
  detailAddress String?  @map("detail_address") @db.VarChar(255)
  phoneNumber   String   @map("phone_number") @db.VarChar(15)

  userFavorCategories UserFavorCategory[]
  reviews             Review[]

  @@map("user")
}

model FoodCategory {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)

  userFavorCategories UserFavorCategory[]

  @@map("food_category")
}

model UserFavorCategory {
  id             Int          @id @default(autoincrement())
  user           User         @relation(fields: [userId], references: [id])
  userId         Int          @map("user_id")
  foodCategory   FoodCategory @relation(fields: [foodCategoryId], references: [id])
  foodCategoryId Int          @map("food_category_id")

  @@index([foodCategoryId], map: "f_category_id")
  @@index([userId], map: "user_id")
  @@map("user_favor_category")
}

model Review {
  id        Int      @id @default(autoincrement())
  storeId   Int      @map("store_id")
  userId    Int      @map("user_id")
  content   String   @db.VarChar(255)
  score     Float
  createdAt DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([storeId], map: "store_id")
  @@index([userId], map: "user_id")
  @@map("reviews")
}

model Store {
  id       Int    @id @default(autoincrement())
  regionId Int    @map("region_id")
  name     String @db.VarChar(100)
  address  String @db.VarChar(255)
  category String @db.VarChar(100)

  reviews Review[]

  @@index([regionId], map: "region_id")
  @@map("stores")
}

model Region {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)

  @@map("regions")
}

model Mission {
  id          Int       @id @default(autoincrement())
  storeId     Int?      @map("store_id")
  reward      Int?
  deadline    DateTime? @db.Date
  missionSpec String?   @map("mission_spec") @db.VarChar(255)

  userMissions UserMissionCh5[]

  @@map("missions")
}

model UserMissionCh5 {
  id        Int    @id @default(autoincrement())
  userId    Int    @map("user_id")
  missionId Int    @map("mission_id")
  status    String @db.VarChar(30)

  mission Mission @relation(fields: [missionId], references: [id])

  @@index([userId], map: "user_id")
  @@index([missionId], map: "mission_id")
  @@map("user_missions_ch5")
}